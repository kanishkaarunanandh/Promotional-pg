PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Option 1: Hostinger Webmail (Matches atriowings.in domain MX records)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@atriowings.in
SMTP_PASS=your_hostinger_email_password

# Option 2: Gmail SMTP (If sending via Gmail account with 16-char App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_sending_gmail_address@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password

# Where incoming contact enquiries should be delivered
CONTACT_TO_EMAIL=info@atriowings.in
