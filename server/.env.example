PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Option 1: Resend HTTP API (RECOMMENDED for Render Free tier - uses HTTPS Port 443, never blocked)
# Get a free API key at https://resend.com (3,000 free emails/month)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=Atriowings Website <onboarding@resend.dev>

# Option 2: Hostinger Webmail (Only works if hosting provider permits outbound SMTP ports 465/587)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@atriowings.in
SMTP_PASS=your_hostinger_email_password

# Option 3: Gmail SMTP (Requires a 16-character Google App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_sending_gmail_address@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password

# Where incoming website enquiries should be delivered
CONTACT_TO_EMAIL=info@atriowings.in
