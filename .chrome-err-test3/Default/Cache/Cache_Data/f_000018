const __vite__css = "/* =====================================================================\r\n   SOFTWARE DEVELOPMENT PAGE: every class is prefixed .sdp-\r\n   Brand: navy #0E2A4E, blue #1E7FD4, cyan #06A3DA\r\n   ===================================================================== */\r\n\r\n.sdp-page {\r\n  --sdp-navy: #0e2a4e;\r\n  --sdp-navy-deep: #0a1f3a;\r\n  --sdp-blue: #1e7fd4;\r\n  --sdp-cyan: #06a3da;\r\n  --sdp-slate: #55657f;\r\n  --sdp-muted: #b6c5da;\r\n  --sdp-nav-h: 96px;        /* space reserved for the fixed navbar */\r\n  overflow-x: clip;\r\n  background: #fff;\r\n  color: var(--sdp-navy);\r\n}\r\n.sdp-page *, .sdp-page *::before, .sdp-page *::after { box-sizing: border-box; }\r\n.sdp-main { display: block; }\r\n\r\n/* ------------------------------------------------------------------ */\r\n/* hero: two independent columns, content 48% / illustration 52%       */\r\n/* ------------------------------------------------------------------ */\r\n.sdp-hero {\r\n  /* --sdp-hero-extra makes the hero taller so the picture can be bigger; the text column\r\n     gets the same amount of bottom padding, so the heading/description/button stay put */\r\n  --sdp-hero-extra: min(130px, max(0px, calc(41.6vw + var(--sdp-nav-h) - 6px - clamp(560px, 82vh, 700px))));\r\n  --sdp-hero-h: calc(clamp(560px, 82vh, 700px) + var(--sdp-hero-extra));\r\n  position: relative;\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 48fr) minmax(0, 52fr);\r\n  align-items: center;\r\n  min-height: var(--sdp-hero-h);\r\n  padding-top: var(--sdp-nav-h);\r\n  overflow: hidden;\r\n  background:\r\n    radial-gradient(55% 70% at 85% 45%, rgba(6, 163, 218, 0.14), transparent 70%),\r\n    linear-gradient(135deg, var(--sdp-navy-deep) 0%, var(--sdp-navy) 100%);\r\n}\r\n\r\n/* The picture sits behind the text column on the right: bigger than before and shifted left\r\n   toward the middle of the hero. The artwork is transparent, so the part that overlaps the\r\n   text column is empty and never covers the heading, description or button (they sit above). */\r\n.sdp-hero-bg {\r\n  position: absolute;\r\n  z-index: 1;\r\n  right: 6vw;\r\n  bottom: 0;\r\n  /* as wide as fits, but never taller than the space below the navbar */\r\n  width: min(74vw, calc((var(--sdp-hero-h) - var(--sdp-nav-h) + 6px) * 16 / 9));\r\n  aspect-ratio: 16 / 9;\r\n  overflow: hidden;\r\n  pointer-events: none;\r\n}\r\n.sdp-hero-img-wrap {\r\n  position: absolute;\r\n  inset: 0;\r\n  will-change: transform;\r\n}\r\n.sdp-hero-img {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;          /* whole picture visible, never cropped or stretched */\r\n  object-position: right bottom;\r\n  /* only a very soft fade at the very bottom edge; sides and top are not masked */\r\n  -webkit-mask-image: linear-gradient(180deg, #000 0, #000 94%, transparent 100%);\r\n  mask-image: linear-gradient(180deg, #000 0, #000 94%, transparent 100%);\r\n}\r\n\r\n.sdp-hero-bg::after { content: none; }\r\n\r\n/* ---- content ---- */\r\n.sdp-hero-content-col {\r\n  position: relative;\r\n  z-index: 3;\r\n  grid-column: 1;\r\n  grid-row: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  min-width: 0;\r\n  padding: 24px clamp(16px, 2vw, 32px) calc(48px + var(--sdp-hero-extra)) max(clamp(24px, 5vw, 80px), calc((100vw - 1296px) / 2));\r\n}\r\n.sdp-hero-content { width: 100%; max-width: 560px; }\r\n\r\n.sdp-eyebrow,\r\n.sdp-kicker {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin: 0;\r\n  font-size: 12.5px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.16em;\r\n  color: var(--sdp-cyan);\r\n}\r\n.sdp-eyebrow-line {\r\n  position: relative;\r\n  width: 40px;\r\n  height: 3px;\r\n  overflow: hidden;\r\n  border-radius: 3px;\r\n  background: rgba(6, 163, 218, 0.3);\r\n}\r\n.sdp-eyebrow-line::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0 auto 0 0;\r\n  width: 45%;\r\n  border-radius: 3px;\r\n  background: linear-gradient(90deg, var(--sdp-blue), var(--sdp-cyan));\r\n  box-shadow: 0 0 10px var(--sdp-cyan);\r\n  animation: sdp-line 2.6s ease-in-out infinite;\r\n}\r\n@keyframes sdp-line {\r\n  0%   { transform: translateX(-100%); }\r\n  100% { transform: translateX(240%); }\r\n}\r\n\r\n.sdp-title {\r\n  margin: 16px 0 16px;\r\n  font-size: clamp(2rem, 3vw, 3.5rem);\r\n  line-height: 1.12;\r\n  font-weight: 800;\r\n  letter-spacing: -0.02em;\r\n  color: #fff;\r\n  text-wrap: balance;\r\n}\r\n.sdp-grad {\r\n  background: linear-gradient(100deg, var(--sdp-cyan), var(--sdp-blue) 60%, var(--sdp-cyan));\r\n  background-size: 200% 100%;\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  color: transparent;\r\n  box-decoration-break: clone;\r\n  -webkit-box-decoration-break: clone;\r\n  animation: sdp-slide 8s linear infinite;\r\n}\r\n@keyframes sdp-slide { to { background-position: -200% 0; } }\r\n\r\n.sdp-desc {\r\n  max-width: 500px;\r\n  margin: 0 0 22px;\r\n  font-size: clamp(15px, 1.1vw, 17px);\r\n  line-height: 1.65;\r\n  color: var(--sdp-muted);\r\n}\r\n\r\n.sdp-highlights {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 12px 20px;\r\n  margin: 0 0 28px;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n.sdp-highlights li {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 0;\r\n  font-size: clamp(13px, 1vw, 15px);\r\n  font-weight: 600;\r\n  line-height: 1.35;\r\n  color: #e6eefb;\r\n}\r\n.sdp-hl-icon {\r\n  flex: none;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 28px;\r\n  height: 28px;\r\n  color: var(--sdp-cyan);\r\n  background: rgba(6, 163, 218, 0.12);\r\n  border: 1px solid rgba(6, 163, 218, 0.28);\r\n  border-radius: 8px;\r\n}\r\n\r\n.sdp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }\r\n\r\n/* ---- buttons ---- */\r\n.sdp-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  padding: 14px 26px;\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n  line-height: 1.2;\r\n  text-decoration: none;\r\n  white-space: nowrap;\r\n  border-radius: 14px;\r\n  cursor: pointer;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease,\r\n    border-color 0.3s ease, filter 0.3s ease;\r\n}\r\n.sdp-btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }\r\n.sdp-btn--primary {\r\n  color: #fff;\r\n  background: linear-gradient(120deg, var(--sdp-blue), var(--sdp-cyan));\r\n  box-shadow: 0 10px 26px -10px rgba(6, 163, 218, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.14) inset;\r\n}\r\n.sdp-btn--primary:hover {\r\n  transform: translateY(-3px);\r\n  filter: brightness(1.07);\r\n  box-shadow: 0 18px 38px -10px rgba(6, 163, 218, 0.95), 0 0 24px rgba(6, 163, 218, 0.45),\r\n    0 0 0 1px rgba(255, 255, 255, 0.22) inset;\r\n}\r\n.sdp-btn-arrow { transition: transform 0.3s ease; }\r\n.sdp-btn--primary:hover .sdp-btn-arrow { transform: translate(4px, -4px); }\r\n.sdp-final .sdp-btn--primary:hover .sdp-btn-arrow { transform: translateX(5px); }\r\n.sdp-btn--ghost {\r\n  color: #fff;\r\n  background: rgba(255, 255, 255, 0.04);\r\n  border: 1px solid rgba(255, 255, 255, 0.28);\r\n}\r\n.sdp-btn--ghost:hover {\r\n  transform: translateY(-3px);\r\n  border-color: var(--sdp-cyan);\r\n  background: rgba(6, 163, 218, 0.12);\r\n}\r\n\r\n/* drifting light particles (decorative; hidden on small screens) */\r\n.sdp-particle {\r\n  position: absolute;\r\n  width: 6px;\r\n  height: 6px;\r\n  border-radius: 50%;\r\n  background: var(--sdp-cyan);\r\n  box-shadow: 0 0 12px 2px rgba(6, 163, 218, 0.6);\r\n  opacity: 0.6;\r\n  pointer-events: none;\r\n  animation: sdp-drift 14s ease-in-out infinite alternate;\r\n}\r\n.sdp-particle--1 { top: 18%; right: 12%; }\r\n.sdp-particle--2 { top: 62%; right: 6%; width: 4px; height: 4px; animation-duration: 18s; animation-delay: -4s; }\r\n.sdp-particle--3 { bottom: 14%; left: 8%; width: 5px; height: 5px; background: var(--sdp-blue); animation-duration: 16s; animation-delay: -8s; }\r\n@keyframes sdp-drift {\r\n  from { transform: translate(0, 0); }\r\n  to   { transform: translate(-26px, 34px); }\r\n}\r\n\r\n/* ------------------------------------------------------------------ */\r\n/* shared section styles                                                */\r\n/* ------------------------------------------------------------------ */\r\n.sdp-section { padding: clamp(64px, 8vw, 104px) 0; }\r\n.sdp-container {\r\n  width: 100%;\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  padding: 0 clamp(16px, 4vw, 40px);\r\n  box-sizing: border-box;\r\n}\r\n.sdp-head { max-width: 680px; margin: 0 0 clamp(32px, 4vw, 52px); }\r\n.sdp-h2 {\r\n  margin: 14px 0 12px;\r\n  font-size: clamp(26px, 3vw, 40px);\r\n  line-height: 1.15;\r\n  font-weight: 800;\r\n  letter-spacing: -0.015em;\r\n  text-wrap: balance;\r\n}\r\n.sdp-sub { margin: 0; font-size: 16px; line-height: 1.7; color: var(--sdp-slate); }\r\n\r\n/* ------------------------------------------------------------------ */\r\n/* approach                                                             */\r\n/* ------------------------------------------------------------------ */\r\n.sdp-approach {\r\n  background:\r\n    radial-gradient(50% 80% at 100% 0%, rgba(6, 163, 218, 0.16), transparent 70%),\r\n    linear-gradient(135deg, var(--sdp-navy-deep), var(--sdp-navy));\r\n  color: #fff;\r\n}\r\n.sdp-head--light .sdp-h2 { color: #fff; }\r\n.sdp-steps {\r\n  position: relative;\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 16px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n/* connecting line through the step nodes */\r\n.sdp-steps-line {\r\n  position: absolute;\r\n  top: 23px;\r\n  left: calc(100% / 12);\r\n  right: calc(100% / 12);\r\n  height: 2px;\r\n  background: linear-gradient(90deg, var(--sdp-blue), var(--sdp-cyan));\r\n  opacity: 0.55;\r\n}\r\n.sdp-steps-line::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: -2px;\r\n  left: 0;\r\n  width: 70px;\r\n  height: 6px;\r\n  border-radius: 6px;\r\n  background: radial-gradient(closest-side, #fff, rgba(6, 163, 218, 0.0));\r\n  animation: sdp-travel 5s linear infinite;\r\n}\r\n@keyframes sdp-travel {\r\n  from { left: 0; }\r\n  to   { left: calc(100% - 70px); }\r\n}\r\n.sdp-step { position: relative; z-index: 1; text-align: center; padding: 0 4px; }\r\n.sdp-step-node {\r\n  display: grid;\r\n  place-items: center;\r\n  width: 48px;\r\n  height: 48px;\r\n  margin: 0 auto 14px;\r\n  color: var(--sdp-cyan);\r\n  background: var(--sdp-navy);\r\n  border: 2px solid var(--sdp-cyan);\r\n  border-radius: 50%;\r\n  box-shadow: 0 0 0 6px rgba(6, 163, 218, 0.12);\r\n}\r\n.sdp-step-num { display: block; margin-bottom: 4px; font-size: 12px; font-weight: 800; letter-spacing: 0.12em; color: var(--sdp-cyan); }\r\n.sdp-step-title { margin: 0 0 6px; font-size: 18px; font-weight: 700; color: #fff; }\r\n.sdp-step-text { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--sdp-muted); }\r\n\r\n/* ------------------------------------------------------------------ */\r\n/* final CTA                                                            */\r\n/* ------------------------------------------------------------------ */\r\n.sdp-final { background: #f4f8fd; }\r\n.sdp-final-box {\r\n  position: relative;\r\n  overflow: hidden;\r\n  padding: clamp(36px, 5vw, 64px) clamp(24px, 5vw, 64px);\r\n  text-align: center;\r\n  color: #fff;\r\n  background:\r\n    radial-gradient(60% 120% at 100% 0%, rgba(6, 163, 218, 0.35), transparent 65%),\r\n    linear-gradient(135deg, var(--sdp-navy), #12396b);\r\n  border-radius: 24px;\r\n  box-shadow: 0 28px 50px -28px rgba(14, 42, 78, 0.8);\r\n}\r\n.sdp-final-title {\r\n  margin: 0 auto 12px;\r\n  max-width: 720px;\r\n  font-size: clamp(24px, 3vw, 36px);\r\n  line-height: 1.2;\r\n  font-weight: 800;\r\n  text-wrap: balance;\r\n}\r\n.sdp-final-text { max-width: 560px; margin: 0 auto 28px; font-size: 16px; line-height: 1.7; color: var(--sdp-muted); }\r\n\r\n/* ------------------------------------------------------------------ */\r\n/* tablet: 768px to 1023px                                              */\r\n/* ------------------------------------------------------------------ */\r\n@media (max-width: 1023px) {\r\n  .sdp-page { --sdp-nav-h: 92px; }\r\n\r\n  /* stack: illustration above, content below */\r\n  .sdp-hero { --sdp-hero-extra: 0px; grid-template-columns: minmax(0, 1fr); min-height: 0; align-items: start; }\r\n  .sdp-hero-bg {\r\n    position: relative;\r\n    right: auto;\r\n    bottom: auto;\r\n    grid-column: 1;\r\n    grid-row: 1;\r\n    justify-self: center;\r\n    width: min(125vw, 900px);        /* larger than the screen so the woman is big, clipped by the hero */\r\n    translate: -16.5% 0;             /* centres her (she sits right of centre in the artwork) */\r\n  }\r\n  .sdp-hero-img {\r\n    object-position: 50% 50%;\r\n    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 82%, transparent 100%);\r\n    mask-image: linear-gradient(180deg, #000 0, #000 82%, transparent 100%);\r\n  }\r\n  .sdp-hero-content-col { grid-column: 1; grid-row: 2; padding: 8px clamp(20px, 5vw, 48px) 52px; }\r\n  .sdp-hero-content { max-width: 680px; margin: 0 auto; }\r\n\r\n  .sdp-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 36px; }\r\n  .sdp-steps-line { display: none; }\r\n}\r\n\r\n/* ------------------------------------------------------------------ */\r\n/* mobile: below 768px                                                  */\r\n/* ------------------------------------------------------------------ */\r\n@media (max-width: 767px) {\r\n  .sdp-page { --sdp-nav-h: 84px; }\r\n  .sdp-hero-bg { width: min(150vw, 560px); }  /* big enough to read, clipped by the hero, no page overflow */\r\n  .sdp-hero-content-col { padding: 4px 20px 44px; }\r\n  .sdp-title { font-size: clamp(1.9rem, 8.6vw, 2.4rem); margin: 1