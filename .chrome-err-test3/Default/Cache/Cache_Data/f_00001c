const __vite__css = "/* =====================================================================\r\n   OUR APPROACH — animated website illustration\r\n   Import after WebDevelopmentPage.css.\r\n   Remove the old rules from WebDevelopmentPage.css that styled this section:\r\n   .overview-split-layout, .overview-narrative, .overview-heading,\r\n   .overview-lead, .overview-body-text, .overview-action,\r\n   .overview-visual-panel, .overview-feature-card, .ov-card-header,\r\n   .ov-icon-wrapper, .ov-card-title, .ov-card-sub, .ov-card-desc\r\n   ===================================================================== */\r\n\r\n.webdev-overview-section.ap-section {\r\n  --ap-navy: #0e2a4e;\r\n  --ap-cyan: #00aeef;\r\n  --ap-text: #5b6b85;\r\n  --ap-line: rgba(14, 42, 78, 0.1);\r\n\r\n  position: relative;\r\n  overflow-x: clip;\r\n  padding: clamp(64px, 8vw, 112px) 0;\r\n  background: linear-gradient(180deg, #f8fafc 0%, #eef4fa 100%);\r\n}\r\n\r\n/* ---------------- layout ---------------- */\r\n.ap-layout {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);\r\n  gap: clamp(40px, 5vw, 88px);\r\n  align-items: center;\r\n}\r\n.ap-copy, .ap-visual-col { min-width: 0; }\r\n\r\n/* ---------------- copy ---------------- */\r\n.ap-heading {\r\n  margin: 20px 0 28px;\r\n  font-size: clamp(2.1rem, 4.2vw, 3.5rem);\r\n  font-weight: 700;\r\n  line-height: 1.12;\r\n  letter-spacing: -0.02em;\r\n  color: var(--ap-navy);\r\n  text-align: left;\r\n}\r\n.ap-lead {\r\n  margin: 0 0 22px;\r\n  max-width: 52ch;\r\n  font-size: clamp(1.05rem, 1.5vw, 1.25rem);\r\n  font-weight: 500;\r\n  line-height: 1.65;\r\n  color: #14233f;\r\n}\r\n.ap-body {\r\n  margin: 0 0 16px;\r\n  max-width: 56ch;\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: var(--ap-text);\r\n}\r\n.ap-cta {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-top: 14px;\r\n}\r\n.ap-cta-arrow { display: inline-flex; }\r\n\r\n/* ---------------- stage ---------------- */\r\n.ap-visual { width: 100%; }\r\n.ap-stage-wrap {\r\n  position: relative;\r\n  width: 100%;\r\n  max-width: 680px;\r\n  margin-inline: auto;\r\n}\r\n.ap-stage {\r\n  position: absolute;\r\n  top: 0;\r\n  transform-origin: 0 0;\r\n}\r\n.ap-layer { position: absolute; inset: 0; }\r\n.ap-layer--decor { pointer-events: none; }\r\n\r\n/* backdrop */\r\n.ap-backdrop { position: absolute; inset: 0; pointer-events: none; }\r\n.ap-backdrop svg { position: absolute; inset: 0; width: 100%; height: 100%; }\r\n.ap-backdrop circle {\r\n  fill: none;\r\n  stroke: rgba(14, 42, 78, 0.12);\r\n  stroke-width: 1;\r\n  stroke-dasharray: 2 7;\r\n}\r\n.ap-glow {\r\n  position: absolute;\r\n  left: 20px;\r\n  top: 190px;\r\n  width: 440px;\r\n  height: 440px;\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle, rgba(0, 174, 239, 0.2), transparent 65%);\r\n  filter: blur(20px);\r\n}\r\n\r\n/* connection lines */\r\n.ap-lines {\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  z-index: 3;\r\n  pointer-events: none;\r\n}\r\n.ap-lines path {\r\n  fill: none;\r\n  stroke: var(--ap-cyan);\r\n  stroke-width: 1.5;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n  opacity: 0.75;\r\n}\r\n.ap-lines circle { fill: #fff; stroke: var(--ap-cyan); stroke-width: 1.5; }\r\n\r\n/* ---------------- browser ---------------- */\r\n.ap-browser {\r\n  position: absolute;\r\n  left: 40px;\r\n  top: 230px;\r\n  z-index: 2;\r\n  width: 400px;\r\n  height: 300px;\r\n  overflow: hidden;\r\n  border-radius: 12px;\r\n  border: 1px solid var(--ap-line);\r\n  background: #fff;\r\n  box-shadow:\r\n    0 1px 0 #fff inset,\r\n    0 30px 60px -24px rgba(14, 42, 78, 0.38),\r\n    0 8px 18px -8px rgba(14, 42, 78, 0.14);\r\n}\r\n.ap-browser-chrome {\r\n  display: flex;\r\n  align-items: center;\r\n  height: 30px;\r\n  padding: 0 12px;\r\n  border-bottom: 1px solid #e6edf5;\r\n  background: #f1f5fa;\r\n}\r\n.ap-dots { display: flex; gap: 5px; }\r\n.ap-dots i { width: 7px; height: 7px; border-radius: 50%; background: #c9d5e3; }\r\n.ap-url {\r\n  width: 150px;\r\n  height: 16px;\r\n  margin-left: 14px;\r\n  border-radius: 8px;\r\n  background: #fff;\r\n  font-size: 9px;\r\n  line-height: 16px;\r\n  text-align: center;\r\n  color: #7b8aa3;\r\n}\r\n.ap-browser-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  height: 270px;\r\n  padding: 14px;\r\n}\r\n\r\n.ap-site-nav { display: flex; align-items: center; justify-content: space-between; height: 24px; }\r\n.ap-logo { display: flex; align-items: center; gap: 6px; }\r\n.ap-logo i { width: 14px; height: 14px; border-radius: 50%; background: linear-gradient(135deg, var(--ap-cyan), var(--ap-navy)); }\r\n.ap-logo b { width: 38px; height: 6px; border-radius: 3px; background: var(--ap-navy); }\r\n.ap-nav-links { display: flex; gap: 10px; }\r\n.ap-nav-links i { width: 24px; height: 5px; border-radius: 3px; background: #cfd9e6; }\r\n.ap-nav-btn { width: 46px; height: 16px; border-radius: 8px; background: var(--ap-navy); }\r\n\r\n.ap-site-hero {\r\n  display: grid;\r\n  grid-template-columns: 1.15fr 1fr;\r\n  gap: 14px;\r\n  height: 120px;\r\n}\r\n.ap-hero-copy { display: flex; flex-direction: column; justify-content: center; gap: 7px; }\r\n.ap-line { display: block; height: 5px; border-radius: 3px; background: #d3dce8; }\r\n.ap-line--lg { height: 9px; background: var(--ap-navy); }\r\n.ap-hero-btns { display: flex; gap: 6px; margin-top: 4px; }\r\n.ap-hero-btns i { width: 44px; height: 18px; border-radius: 9px; border: 1.5px solid #cfd9e6; }\r\n.ap-hero-btns i.is-solid { width: 64px; border-color: var(--ap-cyan); background: var(--ap-cyan); }\r\n.ap-hero-img { overflow: hidden; border-radius: 8px; }\r\n.ap-img { display: block; width: 100%; height: 100%; }\r\n\r\n.ap-site-blocks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; height: 64px; }\r\n.ap-block {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  padding: 9px;\r\n  border: 1px solid #e3eaf3;\r\n  border-radius: 8px;\r\n  background: #fbfdff;\r\n}\r\n.ap-block i { width: 14px; height: 14px; border-radius: 50%; background: rgba(0, 174, 239, 0.35); }\r\n.ap-block i.is-navy { background: rgba(14, 42, 78, 0.25); }\r\n.ap-block > span { height: 4px; border-radius: 2px; background: #d3dce8; }\r\n.ap-block > span:last-child { width: 65%; }\r\n.ap-block--chart { flex-direction: row; align-items: flex-end; gap: 5px; }\r\n.ap-block--chart span {\r\n  flex: 1;\r\n  height: auto;\r\n  border-radius: 2px 2px 0 0;\r\n  background: linear-gradient(180deg, var(--ap-cyan), rgba(0, 174, 239, 0.35));\r\n  transform-origin: bottom center;\r\n}\r\n\r\n/* ---------------- phone ---------------- */\r\n.ap-phone {\r\n  position: absolute;\r\n  left: 330px;\r\n  top: 380px;\r\n  z-index: 3;\r\n  width: 120px;\r\n  height: 240px;\r\n  overflow: hidden;\r\n  border: 5px solid var(--ap-navy);\r\n  border-radius: 22px;\r\n  background: #fff;\r\n  box-shadow: 0 30px 50px -20px rgba(14, 42, 78, 0.55);\r\n}\r\n.ap-phone-notch {\r\n  position: absolute;\r\n  top: 4px;\r\n  left: 50%;\r\n  width: 34px;\r\n  height: 7px;\r\n  border-radius: 4px;\r\n  background: var(--ap-navy);\r\n  transform: translateX(-50%);\r\n}\r\n.ap-phone-screen { display: flex; flex-direction: column; gap: 7px; padding: 18px 9px 9px; }\r\n.ap-phone-nav { display: flex; align-items: center; justify-content: space-between; }\r\n.ap-phone-nav span { display: flex; flex-direction: column; gap: 2.5px; }\r\n.ap-phone-nav span i { width: 12px; height: 2px; border-radius: 1px; background: var(--ap-navy); }\r\n.ap-phone-nav b { width: 14px; height: 14px; border-radius: 50%; background: linear-gradient(135deg, var(--ap-cyan), var(--ap-navy)); }\r\n.ap-phone-hero { height: 62px; overflow: hidden; border-radius: 7px; }\r\n.ap-phone-btn { width: 58px; height: 16px; margin-top: 2px; border-radius: 8px; background: var(--ap-cyan); }\r\n.ap-phone-rows { display: flex; flex-direction: column; gap: 5px; margin-top: 4px; }\r\n.ap-phone-rows i { height: 16px; border: 1px solid #e3eaf3; border-radius: 6px; background: #fbfdff; }\r\n\r\n/* ---------------- floating decoration ---------------- */\r\n.ap-float { position: absolute; display: block; }\r\n.ap-float > span { display: block; }\r\n.ap-float-ring { width: 34px; height: 34px; border: 2px solid rgba(0, 174, 239, 0.7); border-radius: 50%; }\r\n.ap-float-plus {\r\n  position: relative;\r\n  width: 18px;\r\n  height: 18px;\r\n  background:\r\n    linear-gradient(rgba(14, 42, 78, 0.4) 0 0) center / 100% 2px no-repeat,\r\n    linear-gradient(rgba(14, 42, 78, 0.4) 0 0) center / 2px 100% no-repeat;\r\n}\r\n.ap-float-diamond { width: 22px; height: 22px; border: 1.5px solid rgba(14, 42, 78, 0.3); transform: rotate(45deg); }\r\n.ap-float-dots {\r\n  width: 60px;\r\n  height: 48px;\r\n  background-image: radial-gradient(circle, rgba(14, 42, 78, 0.28) 1.5px, transparent 2px);\r\n  background-size: 12px 12px;\r\n}\r\n\r\n/* ---------------- feature panels ---------------- */\r\n.ap-slot { position: absolute; z-index: 5; height: 180px; }\r\n.ap-slot-inner { height: 100%; }\r\n\r\n.ap-panel {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100%;\r\n  padding: 16px;\r\n  border: 1px solid var(--ap-line);\r\n  border-radius: 12px;\r\n  background: rgba(255, 255, 255, 0.94);\r\n  -webkit-backdrop-filter: blur(8px);\r\n  backdrop-filter: blur(8px);\r\n  box-shadow:\r\n    inset 0 1px 0 #fff,\r\n    0 1px 2px rgba(14, 42, 78, 0.05),\r\n    0 24px 40px -24px rgba(14, 42, 78, 0.35);\r\n  transition:\r\n    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),\r\n    border-color 0.3s ease,\r\n    box-shadow 0.4s ease;\r\n}\r\n.ap-panel:hover {\r\n  transform: translateY(-4px);\r\n  border-color: rgba(0, 174, 239, 0.6);\r\n  box-shadow:\r\n    inset 0 1px 0 #fff,\r\n    0 2px 4px rgba(14, 42, 78, 0.06),\r\n    0 30px 46px -24px rgba(0, 174, 239, 0.4);\r\n}\r\n\r\n.ap-panel-head { display: flex; align-items: flex-start; gap: 12px; }\r\n.ap-panel-icon {\r\n  display: grid;\r\n  flex: none;\r\n  place-items: center;\r\n  width: 32px;\r\n  height: 32px;\r\n  border: 1.5px solid rgba(0, 174, 239, 0.4);\r\n  border-radius: 50%;\r\n  background: #f2fbff;\r\n  color: var(--ap-cyan);\r\n  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s, color 0.3s;\r\n}\r\n.ap-panel:hover .ap-panel-icon {\r\n  transform: translate(2px, -2px);\r\n  background: var(--ap-cyan);\r\n  color: #fff;\r\n}\r\n.ap-panel-num {\r\n  display: block;\r\n  font-size: 10.5px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.12em;\r\n  color: var(--ap-cyan);\r\n}\r\n.ap-panel-title {\r\n  margin: 2px 0 0;\r\n  font-size: 14.5px;\r\n  font-weight: 700;\r\n  line-height: 1.25;\r\n  color: var(--ap-navy);\r\n  text-align: left;\r\n}\r\n.ap-panel-label {\r\n  margin: 8px 0 0;\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n  color: var(--ap-text);\r\n}\r\n.ap-panel-visual { margin-top: auto; height: 48px; }\r\n\r\n/* on the desktop illustration the long description is kept for screen readers only */\r\n.ap-panel--stage .ap-panel-desc {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  margin: -1px;\r\n  padding: 0;\r\n  overflow: hidden;\r\n  clip: rect(0 0 0 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n\r\n/* ---------------- mini visuals ---------------- */\r\n.ap-sitemap { display: block; width: 100%; height: 48px; overflow: visible; }\r\n.ap-sitemap path { fill: none; stroke: rgba(14, 42, 78, 0.35); stroke-width: 1.2; stroke-linecap: round; }\r\n.ap-sitemap rect { fill: #e8f7fe; stroke: rgba(0, 174, 239, 0.7); stroke-width: 1; }\r\n.ap-sitemap rect.is-root { fill: var(--ap-navy); stroke: var(--ap-navy); }\r\n.ap-sitemap rect.is-accent { fill: var(--ap-cyan); stroke: var(--ap-cyan); }\r\n.ap-sitemap rect.is-leaf { fill: #fff; stroke: rgba(14, 42, 78, 0.3); }\r\n\r\n.ap-system { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }\r\n.ap-swatches { display: flex; }\r\n.ap-swatches i {\r\n  display: block;\r\n  width: 16px;\r\n  height: 16px;\r\n  margin-left: -4px;\r\n  border: 2px solid #fff;\r\n  border-radius: 50%;\r\n  box-shadow: 0 0 0 1px rgba(14, 42, 78, 0.1);\r\n}\r\n.ap-swatches i:first-child { margin-left: 0; }\r\n.ap-type { display: flex; align-items: baseline; gap: 4px; color: var(--ap-navy); }\r\n.ap-type b { font-size: 16px; line-height: 1; }\r\n.ap-type em { font-size: 11px; font-style: normal; font-weight: 500; opacity: 0.6; }\r\n.ap-toggle { display: block; width: 26px; height: 14px; padding: 2px; border-radius: 7px; background: var(--ap-cyan); }\r\n.ap-toggle i { display: block; width: 10px; height: 10px; margin-left: auto; border-radius: 50%; background: #fff; }\r\n.ap-chip {\r\n  padding: 0 9px;\r\n  border-radius: 7px;\r\n  background: var(--ap-navy);\r\n  font-size: 9.5px;\r\n  font-weight: 600;\r\n  line-height: 18px;\r\n  color: #fff;\r\n}\r\n.ap-input { display: block; width: 44px; height: 16px; border: 1.5px solid #cfd9e6; border-radius: 6px; }\r\n\r\n.ap-speed { display: flex; align-items: center; gap: 14px; height: 48px; }\r\n.ap-ring-wrap { position: relative; display: block; flex: none; width: 48px; height: 48px; }\r\n.ap-ring { display: block; width: 100%; height: 100%; transform: rotate(-90deg); }\r\n.ap-ring circle { fill: none; stroke-width: 4; }\r\n.ap-ring-track { stroke: #e3ecf5; }\r\n.ap-ring-arc { stroke: var(--ap-cyan); stroke-linecap: round; }\r\n.ap-ring-icon { position: absolute; inset: 0; margin: auto; color: var(--ap-navy); }\r\n.ap-speed-bars { display: flex; flex: 1; align-items: flex-end; gap: 5px; height: 40px; }\r\n.ap-speed-bars i {\r\n  flex: 1;\r\n  border-radius: 2px 2px 0 0;\r\n  background: linear-gradient(180deg, var(--ap-cyan), rgba(0, 174, 239, 0.3));\r\n  transform-origin: bottom center;\r\n}\r\n\r\n/* ---------------- feature list (tablet + mobile) ---------------- */\r\n.ap-feature-list {\r\n  display: none;\r\n  list-style: none;\r\n  margin: 32px 0 0;\r\n  padding: 0;\r\n  gap: 16px;\r\n}\r\n.ap-panel--list { height: auto; }\r\n.ap-panel--list .ap-panel-desc {\r\n  margin: 10px 0 0;\r\n  font-size: 13.5px;\r\n  line-height: 1.6;\r\n  color: var(--ap-text);\r\n}\r\n.ap-panel--list .ap-panel-visual { margin-top: 16px; }\r\n\r\n/* ---------------- tablet ---------------- */\r\n@media (max-width: 1099px) {\r\n  .ap-layout { grid-template-columns: 1fr; gap: 48px; }\r\n  .ap-stage-wrap { max-width: 520px; }\r\n  .ap-slot, .ap-lines { display: none; }\r\n  .ap-feature-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }\r\n  .ap-feature-list li:last-child { grid-column: 1 / -1; }\r\n}\r\n\r\n/* ---------------- mobile ---------------- */\r\n@media (max-width: 640px) {\r\n  .ap-feature-list { grid-template-columns: 1fr; }\r\n  .ap-feature-list li:last-child { grid-column: auto; }\r\n  .ap-heading { margin-bottom: 22px; }\r\n}\r\n\r\n/* ---------------- reduced motion ---------------- */\r\n@media (prefers-reduced-motion: reduce) {\r\n  .ap-panel, .ap-panel-icon { transition: none; }\r\n  .ap-panel:hover { transform: none; }\r\n}\r\n\r\n/* =====================================================================\r\n   OUR APPROACH: always-on \"breathing\" accents for the LEFT copy only.\r\n   Pure CSS keyframes, infinite, start on page load. No hover / scroll /\r\n   in-view dependency. Only colour, opacity, glow and brightness change,\r\n   so nothing moves and the layout cannot shift.\r\n   Brand colours: blue #1E7FD4, cyan #06A3DA.\r\n   ===================================================================== */\r\n\r\n/* eyebrow line: gentle brightness + glow pulse */\r\n.ap-copy .ap-blink-line {\r\n  animation: ap-line-pulse 2.4s ease-in-out 0s infinite alternate;\r\n}\r\n/* eyebrow text: colour drifts between the two brand blues */\r\n.ap-copy .ap-blink-eyebrow {\r\n  animation: ap-eyebrow-pulse 2.4s ease-in-out 0.3s infinite alternate;\r\n}\r\n/* description paragraphs: soft opacity breathing, staggered */\r\n.ap-copy .ap-blink-text { animation: ap-text-breathe 2.8s ease-in-out infinite alternate; }\r\n.ap-copy .ap-blink-text--1 { animation-delay: 0.9s; }\r\n.ap-copy .ap-blink-text--2 { animation-delay: 1.3s; }\r\n.ap-copy .ap-blink-text--3 { animation-delay: 1.7s; }\r\n\r\n@keyframes ap-line-pulse {\r\n  from { filter: brightness(0.9); box-shadow: 0 0 0 rgba(6, 163, 218, 0); }\r\n  to   { filter: brightness(1.25); box-shadow: 0 0 10px rgba(6, 163, 218, 0.55); }\r\n}\r\n@keyframes ap-eyebrow-pulse {\r\n  from { color: #1e7fd4; }\r\n  to   { color: #06a3da; }\r\n}\r\n@keyframes ap-text-breathe {\r\n  from { opacity: 0.85; }\r\n  to   { opacity: 1; }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .ap-copy .ap-blink-line,\r\n  .ap-copy .ap-blink-eyebrow,\r\n  .ap-copy .ap-blink-text,\r\n  .ap-copy .ap-blink-cta { animation: none; }\r\n}\r\n\r\n/* =====================================================================\r\n   OUR APPROACH: extra responsive polish (tablet + mobile).\r\n   Layout order is eyebrow, heading, paragraphs, CTA, then the\r\n   illustration, followed by the three feature cards as a list.\r\n   The always-on animations stay ON at every size; only the glow is\r\n   toned down on small screens.\r\n   ===================================================================== */\r\n\r\n/* Tablet: 641px to 1099px, single column, comfortable line lengths */\r\n@media (min-width: 641px) and (max-width: 1099px) {\r\n  .webdev-overview-section.ap-section { padding: 72px 0 80px; }\r\n  .ap-copy { max-width: 720px; }\r\n  .ap-heading { font-size: clamp(2.2rem, 5.6vw, 3rem); margin-bottom: 24px; }\r\n  .ap-lead, .ap-body { max-width: 62ch; }\r\n  .ap-stage-wrap { max-width: 560px; }\r\n}\r\n\r\n/* Mobile */\r\n@media (max-width: 640px) {\r\n  .webdev-overview-section.ap-section { padding: 56px 0 64px; }\r\n  .ap-layout { gap: 36px; }\r\n\r\n  .ap-copy { overflow-wrap: anywhere; }\r\n  .ap-heading {\r\n    margin: 14px 0 18px;\r\n    font-size: clamp(1.85rem, 8.2vw, 2.25rem);\r\n    line-height: 1.15;\r\n  }\r\n  .ap-lead { max-width: none; margin-bottom: 16px; font-size: 1.05rem; line-height: 1.6; }\r\n  .ap-body { max-width: none; margin-bottom: 14px; font-size: 15px; line-height: 1.75; }\r\n\r\n  /* easy-to-tap CTA */\r\n  .ap-copy .ap-cta.ap-blink-cta {\r\n    min-height: 52px;\r\n    margin-top: 12px;\r\n    padding: 14px 26px;\r\n    font-size: 16px;\r\n  }\r\n\r\n  /* illustration: cropped composition, centred, never wider than the screen */\r\n  .ap-stage-wrap { max-width: 100%; }\r\n  .ap-feature-list { margin-top: 24px; gap: 14px; }\r\n\r\n  /* lighter CTA glow on small screens (animation itself stays on) */\r\n  .ap-copy .ap-blink-cta { animation-name: ap-cta-gradient, ap-cta-glow-sm; }\r\n}\r\n\r\n\r\n/* Very small phones */\r\n@media (max-width: 360px) {\r\n  .ap-heading { font-size: 1.7rem; }\r\n  .ap-body { font-size: 14.5px; }\r\n}\r\n\r\n/* Reduced motion: static alternative (re-asserted so it also covers the\r\n   small-screen animation names above) */\r\n@media (prefers-reduced-motion: reduce) {\r\n  .ap-copy .ap-blink-line,\r\n  .ap-copy .ap-blink-eyebrow,\r\n  .ap-copy .ap-blink-text,\r\n  .ap-copy .ap-blink-cta { animation: none !important; }\r\n}\r\n\r\n\r\n/* =====================================================================\r\n   OUR APPROACH: gradient heading accent + premium CTA (always on)\r\n   ===================================================================== */\r\n\r\n/* Heading: only \"Your Business\" gets the blue-to-cyan gradient. It slowly\r\n   slides and its soft cyan glow pulses. The rest stays dark navy. */\r\n.ap-grad-text {\r\n  background: linear-gradient(100deg, #1e7fd4 0%, #06a3da 35%, #1e7fd4 70%, #06a3da 100%);\r\n  background-size: 220% 100%;\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  color: #1e7fd4; /* fallback */\r\n  -webkit-box-decoration-break: clone;\r\n  box-decoration-break: clone;\r\n  animation:\r\n    ap-grad-slide 6s linear infinite,\r\n    ap-grad-glow 3.2s ease-in-out 0.4s infinite alternate;\r\n}\r\n@keyframes ap-grad-slide {\r\n  from { background-position: 0% 50%; }\r\n  to   { background-position: 220% 50%; }\r\n}\r\n@keyframes ap-grad-glow {\r\n  from { filter: drop-shadow(0 0 0 rgba(6, 163, 218, 0)); }\r\n  to   { filter: drop-shadow(0 2px 12px rgba(6, 163, 218, 0.38)); }\r\n}\r\n\r\n/* CTA: gradient pill, pulsing glow, periodic shine, nudging arrow */\r\n.ap-copy .ap-cta.ap-blink-cta {\r\n  position: relative;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin-top: 18px;\r\n  padding: 15px 30px;\r\n  min-height: 52px;\r\n  border: 0;\r\n  border-radius: 999px;\r\n  overflow: hidden;\r\n  isolation: isolate;\r\n  font-weight: 700;\r\n  font-size: 16px;\r\n  letter-spacing: 0.01em;\r\n  text-decoration: none;\r\n  color: #fff;\r\n  background: linear-gradient(100deg, #1e7fd4, #06a3da, #1e7fd4);\r\n  background-size: 200% 100%;\r\n  box-shadow: 0 8px 22px -8px rgba(30, 127, 212, 0.6);\r\n  animation:\r\n    ap-cta-gradient 4.5s ease-in-out infinite alternate,\r\n    ap-cta-glow 2.6s ease-in-out infinite alternate;\r\n  transition: filter 0.3s ease;\r\n}\r\n.ap-copy .ap-cta.ap-blink-cta:hover,\r\n.ap-copy .ap-cta.ap-blink-cta:focus-visible {\r\n  color: #fff;\r\n  filter: brightness(1.1) saturate(1.1);\r\n}\r\n.ap-copy .ap-cta.ap-blink-cta:focus-visible { outline: 2px solid #06a3da; outline-offset: 3px; }\r\n\r\n/* shine sweep every few seconds */\r\n.ap-copy .ap-cta.ap-blink-cta::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  bottom: 0;\r\n  left: -60%;\r\n  width: 40%;\r\n  z-index: -1;\r\n  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent);\r\n  transform: skewX(-20deg);\r\n  animation: ap-cta-shine 4.2s ease-in-out 1s infinite;\r\n}\r\n\r\n/* arrow gently nudges right and back (inner icon, so it never fights the\r\n   existing Framer Motion hover movement on the wrapper) */\r\n.ap-copy .ap-cta .ap-cta-arrow svg {\r\n  animation: ap-cta-arrow 1.8s ease-in-out infinite;\r\n}\r\n\r\n@keyframes ap-cta-gradient {\r\n  from { background-position: 0% 50%; }\r\n  to   { background-position: 100% 50%; }\r\n}\r\n@keyframes ap-cta-glow {\r\n  from { box-shadow: 0 8px 22px -8px rgba(30, 127, 212, 0.55), 0 0 0 0 rgba(6, 163, 218, 0.0); }\r\n  to   { box-shadow: 0 12px 32px -6px rgba(6, 163, 218, 0.75), 0 0 0 6px rgba(6, 163, 218, 0.12); }\r\n}\r\n@keyframes ap-cta-glow-sm {\r\n  from { box-shadow: 0 6px 16px -8px rgba(30, 127, 212, 0.55), 0 0 0 0 rgba(6, 163, 218, 0); }\r\n  to   { box-shadow: 0 8px 20px -6px rgba(6, 163, 218, 0.7), 0 0 0 4px rgba(6, 163, 218, 0.1); }\r\n}\r\n@keyframes ap-cta-shine {\r\n  0%, 55% { left: -60%; }\r\n  100%    { left: 130%; }\r\n}\r\n@keyframes ap-cta-arrow {\r\n  0%, 100% { transform: translateX(0); }\r\n  50%      { transform: translateX(4px); }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .ap-grad-text,\r\n  .ap-copy .ap-cta.ap-blink-cta,\r\n  .ap-copy .ap-cta.ap-blink-cta::after,\r\n  .ap-copy .ap-cta .ap-cta-arrow svg { animation: none !important; }\r\n  .ap-copy .ap-cta.ap-blink-cta::after { display: none; }\r\n}"
